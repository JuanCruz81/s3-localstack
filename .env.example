# Variables de entorno para desarrollo con LocalStack
# Copia este archivo a `.env` y modifica según necesites.

# Credenciales y región (usadas por SDKs y scripts)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# Endpoint de LocalStack (útil si ejecutas código fuera del contenedor)
# LocalStack emula las APIs de AWS en tu máquina; apuntando el SDK/CLI a este
# endpoint (`http://localhost:4566`) enviarás las peticiones a LocalStack en
# lugar de a AWS real. Puedes usar credenciales dummy como `test/test`.
LOCALSTACK_ENDPOINT=http://localhost:4566

# Nombre del bucket principal y bucket procesado (lambda usa `${BUCKET}-processed` si no se define)
BUCKET=mi-bucket
#PROCESSED_BUCKET=mi-bucket-processed

# IAM / Lambda role (entornos reales)
# ARN del role que será usado por la Lambda. En LocalStack usamos por defecto
# `arn:aws:iam::000000000000:role/lambda-role`. En AWS real sustituye por tu ARN.
LAMBDA_ROLE_ARN=arn:aws:iam::000000000000:role/lambda-role

# Ejemplo mínimo de política para el role de ejecución de la Lambda (usar en AWS real)
# {
#   "Version": "2012-10-17",
#   "Statement": [
#     {
#       "Effect": "Allow",
#       "Action": ["s3:GetObject","s3:PutObject","s3:HeadBucket","s3:CreateBucket"],
#       "Resource": [
#         "arn:aws:s3:::mi-bucket/*",
#         "arn:aws:s3:::mi-bucket-processed/*",
#         "arn:aws:s3:::mi-bucket",
#         "arn:aws:s3:::mi-bucket-processed"
#       ]
#     }
#   ]
# }

# Opciones para el frontend de prueba
PORT=3000

# Variables para debugging/local runner
DEBUG_BUCKET=mi-bucket
DEBUG_KEY=test.txt

# Docker Compose / LocalStack (ejemplos)
# En docker-compose.yml exporta estas variables al arrancar LocalStack
#SERVICES=s3,lambda,iam
#LAMBDA_EXECUTOR=docker
